//Given a string s, check if it can be constructed by taking a substring of it and appending multiple copies of the substring together.//(leetcode 459)

#include <string.h>
#include <stdbool.h>

bool repeatedSubstringPattern(char* s)
{
    int n = strlen(s);

    for (int len = 1; len <= n / 2; len++)
    {
        if (n % len != 0)
            continue;

        bool match = true;

        for (int i = len; i < n; i++)
        {
            if (s[i] != s[i % len])
            {
                match = false;
                break;
            }
        }

        if (match)
            return true;
    }

    return false;
}
