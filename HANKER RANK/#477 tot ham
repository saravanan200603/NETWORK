477. Total Hamming Distance ex3

int totalHammingDistance(int* nums, int numsSize) {
    int answer = 0;

    for (int bit = 0; bit < 31; bit++) {
        int ones = 0;

        for (int i = 0; i < numsSize; i++) {
            if ((nums[i] >> bit) & 1)
                ones++;
        }

        int zeros = numsSize - ones;

        answer += ones * zeros;
    }

    return answer;
}
